# Canonical URL: force HTTPS and strip www.
# Every variant (http://, http://www., https://www.) 301s to
# https://biorevolution.uk/<path>. Wildcard AutoSSL covers www. so the
# TLS handshake on https://www. succeeds before the redirect fires.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect any www. host to the bare domain over HTTPS
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Redirect any plain HTTP request to HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>
